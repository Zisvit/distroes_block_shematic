digraph OS_Simple {
  rankdir=TB;
  splines=ortho;
  newrank=true;
  nodesep=1.0;
  ranksep=1.35;
  pad=0.4;
  bgcolor="white";

  node [fontname="DejaVu Sans", fontsize=12, penwidth=1.5];
  edge [fontname="DejaVu Sans Bold", fontsize=11, penwidth=1.8, arrowsize=0.9];

  START [label="СТАРТ\nКакую ОС ставить?", shape=ellipse, style=filled, fillcolor="#1f2937", fontcolor=white, fontsize=14, width=2.4, height=1.1];

  Q1 [label="Играешь\nв AAA?", shape=diamond, style=filled, fillcolor="#fef08a", width=2.4, height=1.3];
  Q2 [label="ПК слабый?\n≤8 ГБ / 10+ лет", shape=diamond, style=filled, fillcolor="#fef08a", width=2.4, height=1.3];
  Q3 [label="Сервер / NAS?", shape=diamond, style=filled, fillcolor="#fef08a", width=2.4, height=1.3];
  Q4 [label="Анонимность /\nпентест?", shape=diamond, style=filled, fillcolor="#fef08a", width=2.4, height=1.3];
  Q5 [label="Кодишь?", shape=diamond, style=filled, fillcolor="#fef08a", width=2.4, height=1.3];
  Q6 [label="Нужны 1С /\nOffice / Photoshop?", shape=diamond, style=filled, fillcolor="#fef08a", width=2.4, height=1.3];
  Q7 [label="Apple +\nесть деньги?", shape=diamond, style=filled, fillcolor="#fef08a", width=2.4, height=1.3];
  Q8 [label="«Просто работает»?", shape=diamond, style=filled, fillcolor="#fef08a", width=2.4, height=1.3];

  START -> Q1 [xlabel="начать", weight=10, color="#1f2937", fontcolor="#1f2937"];
  Q1 -> Q2 [xlabel="нет", weight=10, color="#1f2937", fontcolor="#1f2937"];
  Q2 -> Q3 [xlabel="нет", weight=10, color="#1f2937", fontcolor="#1f2937"];
  Q3 -> Q4 [xlabel="нет", weight=10, color="#1f2937", fontcolor="#1f2937"];
  Q4 -> Q5 [xlabel="нет", weight=10, color="#1f2937", fontcolor="#1f2937"];
  Q5 -> Q6 [xlabel="нет", weight=10, color="#1f2937", fontcolor="#1f2937"];
  Q6 -> Q7 [xlabel="нет", weight=10, color="#1f2937", fontcolor="#1f2937"];
  Q7 -> Q8 [xlabel="нет", weight=10, color="#1f2937", fontcolor="#1f2937"];

  subgraph CL_GAMING {
    label="Гейминг"; style="filled,rounded"; fillcolor="#faf5ff"; color="#c084fc"; fontsize=11;
    N_WINDOWS_11 [label="Windows 11", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_STEAMOS [label="SteamOS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_BAZZITE [label="Bazzite", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_NOBARA [label="Nobara", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_CHIMERAOS [label="ChimeraOS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_HOLOISO [label="HoloISO", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_ATLASOS [label="AtlasOS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_POP__OS [label="Pop!_OS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
  }

  subgraph CL_OLDPC {
    label="Слабый ПК"; style="filled,rounded"; fillcolor="#fefce8"; color="#eab308"; fontsize=11;
    N_ANTIX [label="antiX", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_PUPPY_LINUX [label="Puppy Linux", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_TINY_CORE [label="Tiny Core", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_LUBUNTU [label="Lubuntu", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_XUBUNTU [label="Xubuntu", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_LINUX_LITE [label="Linux Lite", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_MX_LINUX [label="MX Linux", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_PORTEUS [label="Porteus", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
  }

  subgraph CL_SERVER {
    label="Сервер / NAS"; style="filled,rounded"; fillcolor="#f0fdf4"; color="#16a34a"; fontsize=11;
    N_UBUNTU_SERVER [label="Ubuntu Server", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_DEBIAN [label="Debian", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_PROXMOX_VE [label="Proxmox VE", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_TRUENAS_SCALE [label="TrueNAS SCALE", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_OPENMEDIAVAULT [label="OpenMediaVault", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_PFSENSE [label="pfSense", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_OPNSENSE [label="OPNsense", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_ROCKY_LINUX [label="Rocky Linux", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
  }

  subgraph CL_PRIV {
    label="Приватность"; style="filled,rounded"; fillcolor="#fdf2f8"; color="#be185d"; fontsize=11;
    N_TAILS [label="Tails", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_QUBES_OS [label="Qubes OS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_KALI_LINUX [label="Kali Linux", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_PARROT_OS [label="Parrot OS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_GRAPHENEOS [label="GrapheneOS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_WHONIX [label="Whonix", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_KODACHI [label="Kodachi", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_TINFOIL_HAT [label="Tinfoil Hat", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
  }

  subgraph CL_DEV {
    label="Разработка"; style="filled,rounded"; fillcolor="#eff6ff"; color="#2563eb"; fontsize=11;
    N_ARCH_LINUX [label="Arch Linux", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_UBUNTU [label="Ubuntu", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_FEDORA [label="Fedora", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_NIXOS [label="NixOS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_OPENSUSE [label="openSUSE", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_MANJARO [label="Manjaro", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_ENDEAVOUROS [label="EndeavourOS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_VOID_LINUX [label="Void Linux", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
  }

  subgraph CL_OFFICE {
    label="Офис / дом"; style="filled,rounded"; fillcolor="#faf5ff"; color="#a855f7"; fontsize=11;
    N_LINUX_MINT [label="Linux Mint", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_ZORIN_OS [label="Zorin OS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_ELEMENTARY_OS [label="elementary OS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_UBUNTU [label="Ubuntu", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_MACOS [label="macOS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_CHROMEOS [label="ChromeOS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_ANDROID_X86 [label="Android-x86", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    N_REACTOS [label="ReactOS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
  }

  Q1 -> N_WINDOWS_11 [xlabel="да", weight=2, color="#1f2937", fontcolor="#1f2937"];
  Q2 -> N_ANTIX [xlabel="да", weight=2, color="#1f2937", fontcolor="#1f2937"];
  Q3 -> N_UBUNTU_SERVER [xlabel="да", weight=2, color="#1f2937", fontcolor="#1f2937"];
  Q4 -> N_TAILS [xlabel="да", weight=2, color="#1f2937", fontcolor="#1f2937"];
  Q5 -> N_ARCH_LINUX [xlabel="да", weight=2, color="#1f2937", fontcolor="#1f2937"];
  Q6 -> N_LINUX_MINT [xlabel="да", weight=2, color="#1f2937", fontcolor="#1f2937"];
  Q7 -> N_LINUX_MINT [xlabel="да", weight=2, color="#1f2937", fontcolor="#1f2937"];
  Q8 -> N_LINUX_MINT [xlabel="да", weight=2, color="#1f2937", fontcolor="#1f2937"];

  N_WINDOWS_11 -> N_STEAMOS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_STEAMOS -> N_BAZZITE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_BAZZITE -> N_NOBARA [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_NOBARA -> N_CHIMERAOS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_CHIMERAOS -> N_HOLOISO [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_HOLOISO -> N_ATLASOS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_ATLASOS -> N_POP__OS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_POP__OS -> FINISH [weight=1];
  N_ANTIX -> N_PUPPY_LINUX [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_PUPPY_LINUX -> N_TINY_CORE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_TINY_CORE -> N_LUBUNTU [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_LUBUNTU -> N_XUBUNTU [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_XUBUNTU -> N_LINUX_LITE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_LINUX_LITE -> N_MX_LINUX [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_MX_LINUX -> N_PORTEUS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_PORTEUS -> FINISH [weight=1];
  N_UBUNTU_SERVER -> N_DEBIAN [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_DEBIAN -> N_PROXMOX_VE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_PROXMOX_VE -> N_TRUENAS_SCALE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_TRUENAS_SCALE -> N_OPENMEDIAVAULT [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_OPENMEDIAVAULT -> N_PFSENSE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_PFSENSE -> N_OPNSENSE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_OPNSENSE -> N_ROCKY_LINUX [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_ROCKY_LINUX -> FINISH [weight=1];
  N_TAILS -> N_QUBES_OS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_QUBES_OS -> N_KALI_LINUX [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_KALI_LINUX -> N_PARROT_OS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_PARROT_OS -> N_GRAPHENEOS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_GRAPHENEOS -> N_WHONIX [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_WHONIX -> N_KODACHI [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_KODACHI -> N_TINFOIL_HAT [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_TINFOIL_HAT -> FINISH [weight=1];
  N_ARCH_LINUX -> N_UBUNTU [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_UBUNTU -> N_FEDORA [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_FEDORA -> N_NIXOS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_NIXOS -> N_OPENSUSE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_OPENSUSE -> N_MANJARO [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_MANJARO -> N_ENDEAVOUROS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_ENDEAVOUROS -> N_VOID_LINUX [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_VOID_LINUX -> FINISH [weight=1];
  N_LINUX_MINT -> N_ZORIN_OS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_ZORIN_OS -> N_ELEMENTARY_OS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_ELEMENTARY_OS -> N_UBUNTU [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_UBUNTU -> N_MACOS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_MACOS -> N_CHROMEOS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_CHROMEOS -> N_ANDROID_X86 [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_ANDROID_X86 -> N_REACTOS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  N_REACTOS -> FINISH [weight=1];

  FINISH [label="ФИНИШ\nставь и не ной", shape=ellipse, style=filled, fillcolor="#1f2937", fontcolor=white, fontsize=13, width=2.4, height=1.1];
}