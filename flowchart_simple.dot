digraph OS_Simple {
  rankdir=TB;
  splines=ortho;
  newrank=true;
  nodesep=0.6;
  ranksep=0.9;
  pad=0.3;
  pack=true;
  bgcolor="white";

  node [fontname="DejaVu Sans", fontsize=10, penwidth=1.3];
  edge [fontname="DejaVu Sans Bold", fontsize=9, penwidth=1.4, arrowsize=0.8];

  START [label="СТАРТ\nКакую ОС ставить?", shape=ellipse, style=filled, fillcolor="#1f2937", fontcolor=white, fontsize=12];

  Q_GAMING [label="Играешь\nв AAA?", shape=diamond, style=filled, fillcolor="#fef08a"];
  Q_WEAK [label="ПК слабый?\n≤8 ГБ / 10+ лет", shape=diamond, style=filled, fillcolor="#fef08a"];
  Q_SERVER [label="Сервер / NAS /\nHomelab?", shape=diamond, style=filled, fillcolor="#fef08a"];
  Q_PRIV [label="Анонимность /\nпентест?", shape=diamond, style=filled, fillcolor="#fef08a"];
  Q_DEV [label="Кодишь?", shape=diamond, style=filled, fillcolor="#fef08a"];
  Q_OFFICE [label="Нужна повседневная\n«просто работает» ОС?", shape=diamond, style=filled, fillcolor="#fef08a"];

  START -> Q_GAMING [xlabel="начать", weight=2, color="#1f2937", fontcolor="#1f2937"];
  Q_GAMING -> Q_WEAK [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  Q_WEAK -> Q_SERVER [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  Q_SERVER -> Q_PRIV [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  Q_PRIV -> Q_DEV [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  Q_DEV -> Q_OFFICE [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];

  subgraph CL_GAMING {
    label="Гейминг";
    style="filled,rounded";
    fillcolor="#faf5ff";
    color="#c084fc";
    fontsize=10;
    S_WINDOWS_11 [label="Windows 11", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_STEAMOS [label="SteamOS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_BAZZITE [label="Bazzite", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_NOBARA [label="Nobara", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_CHIMERAOS [label="ChimeraOS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_HOLOISO [label="HoloISO", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_ATLASOS [label="AtlasOS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_POP__OS [label="Pop!_OS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
  }

  subgraph CL_WEAK {
    label="Слабый ПК / Воскрешение железа";
    style="filled,rounded";
    fillcolor="#fefce8";
    color="#eab308";
    fontsize=10;
    S_ANTIX [label="antiX", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_PUPPY_LINUX [label="Puppy Linux", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_TINY_CORE [label="Tiny Core", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_LUBUNTU [label="Lubuntu", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_XUBUNTU [label="Xubuntu", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_LINUX_LITE [label="Linux Lite", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_MX_LINUX [label="MX Linux", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_PORTEUS [label="Porteus", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
  }

  subgraph CL_SERVER {
    label="Сервер / NAS / Homelab";
    style="filled,rounded";
    fillcolor="#f0fdf4";
    color="#16a34a";
    fontsize=10;
    S_PROXMOX_VE [label="Proxmox VE", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_UBUNTU_SERVER [label="Ubuntu Server", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_DEBIAN [label="Debian", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_TRUENAS_SCALE [label="TrueNAS SCALE", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_OPENMEDIAVAULT [label="OpenMediaVault", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_PFSENSE [label="pfSense", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_OPNSENSE [label="OPNsense", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_ROCKY_LINUX [label="Rocky Linux", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
  }

  subgraph CL_PRIV {
    label="Приватность / Пентест";
    style="filled,rounded";
    fillcolor="#fdf2f8";
    color="#be185d";
    fontsize=10;
    S_TAILS [label="Tails", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_QUBES_OS [label="Qubes OS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_KALI_LINUX [label="Kali Linux", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_PARROT_OS [label="Parrot OS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_GRAPHENEOS [label="GrapheneOS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_WHONIX [label="Whonix", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_KODACHI [label="Kodachi", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_TINFOIL_HAT [label="Tinfoil Hat", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
  }

  subgraph CL_DEV {
    label="Разработка";
    style="filled,rounded";
    fillcolor="#eff6ff";
    color="#2563eb";
    fontsize=10;
    S_ARCH_LINUX [label="Arch Linux", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_ENDEAVOUROS [label="EndeavourOS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_NIXOS [label="NixOS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_FEDORA [label="Fedora", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_OPENSUSE [label="openSUSE", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_UBUNTU [label="Ubuntu", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_MANJARO [label="Manjaro", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_VOID_LINUX [label="Void Linux", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
  }

  subgraph CL_OFFICE {
    label="Повседневный / Офис";
    style="filled,rounded";
    fillcolor="#fef2f2";
    color="#dc2626";
    fontsize=10;
    S_LINUX_MINT [label="Linux Mint", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_ZORIN_OS [label="Zorin OS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_ELEMENTARY_OS [label="elementary OS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_UBUNTU [label="Ubuntu", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_CHROMEOS [label="ChromeOS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_MACOS [label="macOS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_ANDROID_X86 [label="Android-x86", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
    S_REACTOS [label="ReactOS", shape=box, style="filled,rounded", fillcolor="#e5e7eb"];
  }

  Q_GAMING -> S_WINDOWS_11 [xlabel="да", weight=2, color="#1f2937", fontcolor="#1f2937"];
  Q_WEAK -> S_ANTIX [xlabel="да", weight=2, color="#1f2937", fontcolor="#1f2937"];
  Q_SERVER -> S_PROXMOX_VE [xlabel="да", weight=2, color="#1f2937", fontcolor="#1f2937"];
  Q_PRIV -> S_TAILS [xlabel="да", weight=2, color="#1f2937", fontcolor="#1f2937"];
  Q_DEV -> S_ARCH_LINUX [xlabel="да", weight=2, color="#1f2937", fontcolor="#1f2937"];
  Q_OFFICE -> S_LINUX_MINT [xlabel="да", weight=2, color="#1f2937", fontcolor="#1f2937"];
  S_WINDOWS_11 -> S_STEAMOS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_STEAMOS -> S_BAZZITE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_BAZZITE -> S_NOBARA [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_NOBARA -> S_CHIMERAOS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_CHIMERAOS -> S_HOLOISO [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_HOLOISO -> S_ATLASOS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_ATLASOS -> S_POP__OS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_ANTIX -> S_PUPPY_LINUX [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_PUPPY_LINUX -> S_TINY_CORE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_TINY_CORE -> S_LUBUNTU [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_LUBUNTU -> S_XUBUNTU [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_XUBUNTU -> S_LINUX_LITE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_LINUX_LITE -> S_MX_LINUX [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_MX_LINUX -> S_PORTEUS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_PROXMOX_VE -> S_UBUNTU_SERVER [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_UBUNTU_SERVER -> S_DEBIAN [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_DEBIAN -> S_TRUENAS_SCALE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_TRUENAS_SCALE -> S_OPENMEDIAVAULT [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_OPENMEDIAVAULT -> S_PFSENSE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_PFSENSE -> S_OPNSENSE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_OPNSENSE -> S_ROCKY_LINUX [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_TAILS -> S_QUBES_OS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_QUBES_OS -> S_KALI_LINUX [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_KALI_LINUX -> S_PARROT_OS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_PARROT_OS -> S_GRAPHENEOS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_GRAPHENEOS -> S_WHONIX [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_WHONIX -> S_KODACHI [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_KODACHI -> S_TINFOIL_HAT [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_ARCH_LINUX -> S_ENDEAVOUROS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_ENDEAVOUROS -> S_NIXOS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_NIXOS -> S_FEDORA [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_FEDORA -> S_OPENSUSE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_OPENSUSE -> S_UBUNTU [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_UBUNTU -> S_MANJARO [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_MANJARO -> S_VOID_LINUX [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_LINUX_MINT -> S_ZORIN_OS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_ZORIN_OS -> S_ELEMENTARY_OS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_ELEMENTARY_OS -> S_UBUNTU [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_UBUNTU -> S_CHROMEOS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_CHROMEOS -> S_MACOS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_MACOS -> S_ANDROID_X86 [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  S_ANDROID_X86 -> S_REACTOS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];

  FINISH [label="ФИНИШ", shape=ellipse, style=filled, fillcolor="#1f2937", fontcolor=white];
  S_POP__OS -> FINISH [weight=1, color="#9ca3af"];
  S_PORTEUS -> FINISH [weight=1, color="#9ca3af"];
  S_ROCKY_LINUX -> FINISH [weight=1, color="#9ca3af"];
  S_TINFOIL_HAT -> FINISH [weight=1, color="#9ca3af"];
  S_VOID_LINUX -> FINISH [weight=1, color="#9ca3af"];
  S_REACTOS -> FINISH [weight=1, color="#9ca3af"];
}