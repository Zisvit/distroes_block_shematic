digraph OS_All {
  rankdir=TB;
  splines=ortho;
  newrank=true;
  nodesep=0.9;
  ranksep=1.25;
  pad=0.4;
  bgcolor="white";

  node [fontname="DejaVu Sans", fontsize=11, penwidth=1.5];
  edge [fontname="DejaVu Sans Bold", fontsize=10, penwidth=1.7, arrowsize=0.9];

  START [label="СТАРТ\nКакую ОС выбрать?", shape=ellipse, style=filled, fillcolor="#1f2937", fontcolor=white, fontsize=13, width=2.6, height=1.1];

  Q1 [label="Для десктопа\nили ноутбука?", shape=diamond, style=filled, fillcolor="#fef08a", width=2.4, height=1.3];
  Q2 [label="Для сервера /\nNAS / Homelab?", shape=diamond, style=filled, fillcolor="#fef08a", width=2.4, height=1.3];
  Q3 [label="Для мобильного\nустройства?", shape=diamond, style=filled, fillcolor="#fef08a", width=2.4, height=1.3];
  Q4 [label="Для встраиваемого\n/ IoT?", shape=diamond, style=filled, fillcolor="#fef08a", width=2.4, height=1.3];
  Q5 [label="Для ретро /\nэмуляции / музея?", shape=diamond, style=filled, fillcolor="#fef08a", width=2.4, height=1.3];
  Q6 [label="Для экспериментов\n/ с нуля?", shape=diamond, style=filled, fillcolor="#fef08a", width=2.4, height=1.3];

  START -> Q1 [xlabel="начать", weight=10, color="#1f2937", fontcolor="#1f2937"];
  Q1 -> Q2 [xlabel="нет", weight=10, color="#1f2937", fontcolor="#1f2937"];
  Q2 -> Q3 [xlabel="нет", weight=10, color="#1f2937", fontcolor="#1f2937"];
  Q3 -> Q4 [xlabel="нет", weight=10, color="#1f2937", fontcolor="#1f2937"];
  Q4 -> Q5 [xlabel="нет", weight=10, color="#1f2937", fontcolor="#1f2937"];
  Q5 -> Q6 [xlabel="нет", weight=10, color="#1f2937", fontcolor="#1f2937"];

  subgraph cluster_desktop {
    label="ДЕСКТОП / НОУТБУК"; style="filled,rounded"; fillcolor="#eff6ff"; color="#2563eb"; fontsize=11;
    D1 [label="Играешь\nв AAA?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.0, height=1.1];
    D2 [label="ПК слабый?\n≤8 ГБ", shape=diamond, style=filled, fillcolor="#fdba74", width=2.0, height=1.1];
    D3 [label="Приватность\nважна?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.0, height=1.1];
    D4 [label="Кодишь /\nразработка?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.0, height=1.1];
    D5 [label="«Просто\nработает»?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.0, height=1.1];
    DESK_WIN [label="Windows 11 / 10", shape=box, style="filled,rounded", fillcolor="#bfdbfe"];
    DESK_MAC [label="macOS", shape=box, style="filled,rounded", fillcolor="#bfdbfe"];
    DESK_MINT [label="Linux Mint", shape=box, style="filled,rounded", fillcolor="#bfdbfe"];
    DESK_ZORIN [label="Zorin OS", shape=box, style="filled,rounded", fillcolor="#bfdbfe"];
    DESK_NOBARA [label="Nobara / SteamOS", shape=box, style="filled,rounded", fillcolor="#bfdbfe"];
    DESK_MX [label="MX Linux / antiX", shape=box, style="filled,rounded", fillcolor="#bfdbfe"];
    DESK_QUBES [label="Qubes OS / Tails", shape=box, style="filled,rounded", fillcolor="#bfdbfe"];
    DESK_ARCH [label="Arch / Fedora / NixOS", shape=box, style="filled,rounded", fillcolor="#bfdbfe"];
    DESK_ELEM [label="elementary OS / Ubuntu", shape=box, style="filled,rounded", fillcolor="#bfdbfe"];
  }
  Q1 -> D1 [xlabel="да", weight=2, color="#1f2937", fontcolor="#1f2937"];
  D1 -> DESK_NOBARA [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  D1 -> D2 [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  D2 -> DESK_MX [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  D2 -> D3 [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  D3 -> DESK_QUBES [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  D3 -> D4 [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  D4 -> DESK_ARCH [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  D4 -> D5 [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  D5 -> DESK_MINT [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  D5 -> DESK_ELEM [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  DESK_NOBARA -> DESK_WIN [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  DESK_MX -> DESK_ZORIN [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  DESK_ELEM -> DESK_MAC [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];

  subgraph cluster_server {
    label="СЕРВЕР / NAS / HOMELAB"; style="filled,rounded"; fillcolor="#f0fdf4"; color="#16a34a"; fontsize=11;
    SRV1 [label="Виртуализация?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.0, height=1.1];
    SRV2 [label="Только NAS?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.0, height=1.1];
    SRV3 [label="Firewall/Router?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.0, height=1.1];
    SRV_PROX [label="Proxmox VE", shape=box, style="filled,rounded", fillcolor="#86efac"];
    SRV_UBU [label="Ubuntu Server", shape=box, style="filled,rounded", fillcolor="#86efac"];
    SRV_DEB [label="Debian", shape=box, style="filled,rounded", fillcolor="#86efac"];
    SRV_RHEL [label="Rocky/Alma/RHEL", shape=box, style="filled,rounded", fillcolor="#86efac"];
    SRV_TRUE [label="TrueNAS SCALE", shape=box, style="filled,rounded", fillcolor="#86efac"];
    SRV_OMV [label="OpenMediaVault", shape=box, style="filled,rounded", fillcolor="#86efac"];
    SRV_PFS [label="pfSense / OPNsense", shape=box, style="filled,rounded", fillcolor="#86efac"];
  }
  Q2 -> SRV1 [xlabel="да", weight=2, color="#1f2937", fontcolor="#1f2937"];
  SRV1 -> SRV_PROX [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  SRV1 -> SRV2 [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  SRV2 -> SRV_TRUE [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  SRV2 -> SRV3 [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  SRV3 -> SRV_PFS [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  SRV3 -> SRV_UBU [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  SRV_PROX -> SRV_DEB [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  SRV_UBU -> SRV_RHEL [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  SRV_TRUE -> SRV_OMV [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];

  subgraph cluster_mobile {
    label="МОБИЛЬНЫЕ"; style="filled,rounded"; fillcolor="#fef3c7"; color="#d97706"; fontsize=11;
    M1 [label="Android или\niOS?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.0, height=1.1];
    M2 [label="Максимум\nприватности?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.0, height=1.1];
    M_IOS [label="iOS / iPadOS", shape=box, style="filled,rounded", fillcolor="#fcd34d"];
    M_GRAPH [label="GrapheneOS", shape=box, style="filled,rounded", fillcolor="#fcd34d"];
    M_CALI [label="CalyxOS / DivestOS", shape=box, style="filled,rounded", fillcolor="#fcd34d"];
    M_LINEAGE [label="LineageOS", shape=box, style="filled,rounded", fillcolor="#fcd34d"];
    M_ANDROID [label="Stock Android", shape=box, style="filled,rounded", fillcolor="#fcd34d"];
  }
  Q3 -> M1 [xlabel="да", weight=2, color="#1f2937", fontcolor="#1f2937"];
  M1 -> M_IOS [xlabel="iOS", weight=1, color="#1f2937", fontcolor="#1f2937"];
  M1 -> M2 [xlabel="Android", weight=2, color="#1f2937", fontcolor="#1f2937"];
  M2 -> M_GRAPH [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  M2 -> M_ANDROID [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  M_GRAPH -> M_CALI [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  M_ANDROID -> M_LINEAGE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];

  subgraph cluster_embedded {
    label="ВСТРАИВАЕМЫЕ / IoT"; style="filled,rounded"; fillcolor="#f1f5f9"; color="#475569"; fontsize=11;
    E1 [label="RTOS или\nLinux?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.0, height=1.1];
    E_ALPINE [label="Alpine Linux", shape=box, style="filled,rounded", fillcolor="#cbd5e1"];
    E_BUILDROOT [label="Buildroot / Yocto", shape=box, style="filled,rounded", fillcolor="#cbd5e1"];
    E_OPENWRT [label="OpenWrt", shape=box, style="filled,rounded", fillcolor="#cbd5e1"];
    E_FREERTOS [label="FreeRTOS", shape=box, style="filled,rounded", fillcolor="#cbd5e1"];
    E_ZEPHYR [label="Zephyr RTOS", shape=box, style="filled,rounded", fillcolor="#cbd5e1"];
    E_VXWORKS [label="VxWorks", shape=box, style="filled,rounded", fillcolor="#cbd5e1"];
  }
  Q4 -> E1 [xlabel="да", weight=2, color="#1f2937", fontcolor="#1f2937"];
  E1 -> E_ALPINE [xlabel="Linux", weight=1, color="#1f2937", fontcolor="#1f2937"];
  E1 -> E_FREERTOS [xlabel="RTOS", weight=2, color="#1f2937", fontcolor="#1f2937"];
  E_ALPINE -> E_BUILDROOT [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  E_ALPINE -> E_OPENWRT [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  E_FREERTOS -> E_ZEPHYR [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  E_FREERTOS -> E_VXWORKS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];

  subgraph cluster_retro {
    label="РЕТРО / МУЗЕЙ"; style="filled,rounded"; fillcolor="#f8fafc"; color="#64748b"; fontsize=11;
    R1 [label="x86/PC или\nдругое?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.0, height=1.1];
    R2 [label="BSD или\nдругое?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.0, height=1.1];
    R_DOS [label="FreeDOS / MS-DOS", shape=box, style="filled,rounded", fillcolor="#e2e8f0"];
    R_REACTOS [label="ReactOS", shape=box, style="filled,rounded", fillcolor="#e2e8f0"];
    R_BSD [label="FreeBSD / OpenBSD / NetBSD", shape=box, style="filled,rounded", fillcolor="#e2e8f0"];
    R_HAIKU [label="Haiku (BeOS)", shape=box, style="filled,rounded", fillcolor="#e2e8f0"];
    R_PLAN9 [label="Plan 9 / 9front", shape=box, style="filled,rounded", fillcolor="#e2e8f0"];
  }
  Q5 -> R1 [xlabel="да", weight=2, color="#1f2937", fontcolor="#1f2937"];
  R1 -> R_DOS [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  R1 -> R2 [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  R2 -> R_BSD [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  R2 -> R_HAIKU [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  R_DOS -> R_REACTOS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  R_HAIKU -> R_PLAN9 [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];

  subgraph cluster_exo {
    label="ЭКЗОТИКА / С НУЛЯ"; style="filled,rounded"; fillcolor="#f5f3ff"; color="#7c3aed"; fontsize=11;
    EX1 [label="Для изучения\nОС?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.0, height=1.1];
    EX_SERENITY [label="SerenityOS", shape=box, style="filled,rounded", fillcolor="#ddd6fe"];
    EX_TOYOS [label="MenuetOS / KolibriOS", shape=box, style="filled,rounded", fillcolor="#ddd6fe"];
    EX_SORTIX [label="Sortix", shape=box, style="filled,rounded", fillcolor="#ddd6fe"];
    EX_AWESOME [label="TempleOS", shape=box, style="filled,rounded", fillcolor="#ddd6fe"];
  }
  Q6 -> EX1 [xlabel="да", weight=2, color="#1f2937", fontcolor="#1f2937"];
  EX1 -> EX_SERENITY [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  EX1 -> EX_TOYOS [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  EX_SERENITY -> EX_SORTIX [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  EX_TOYOS -> EX_AWESOME [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];

  FINISH [label="ФИНИШ", shape=ellipse, style=filled, fillcolor="#1f2937", fontcolor=white, fontsize=13];
  DESK_WIN -> FINISH [weight=1];
  DESK_ARCH -> FINISH [weight=1];
  SRV_PROX -> FINISH [weight=1];
  M_IOS -> FINISH [weight=1];
  E_ALPINE -> FINISH [weight=1];
  R_DOS -> FINISH [weight=1];
  EX_SERENITY -> FINISH [weight=1];
}