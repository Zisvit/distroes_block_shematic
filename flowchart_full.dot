digraph OS_Full {
  rankdir=TB;
  splines=ortho;
  newrank=true;
  nodesep=0.4;
  ranksep=0.7;
  pad=0.3;
  pack=true;
  bgcolor="white";

  node [fontname="DejaVu Sans", fontsize=8, penwidth=1.1];
  edge [fontname="DejaVu Sans", fontsize=7, penwidth=1.0, arrowsize=0.6];

  START [label="START", shape=ellipse, style=filled, fillcolor="#1f2937", fontcolor=white];

