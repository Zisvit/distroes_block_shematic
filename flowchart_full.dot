digraph OS_Full {
  layout=fdp; overlap=false; sep="+8";
  splines=line;
  newrank=true;
  nodesep=0.7;
  ranksep=1.0;
  pad=0.4;
  bgcolor="white";

  node [fontname="DejaVu Sans", fontsize=9, penwidth=1.2];
  edge [fontname="DejaVu Sans", fontsize=8, penwidth=1.2, arrowsize=0.7];

  START [label="START", shape=ellipse, style=filled, fillcolor="#1f2937", fontcolor=white];

