digraph OS_Choice {
  rankdir=TB;
  splines=ortho;
  newrank=true;
  nodesep=0.7;
  ranksep=1.05;
  pad=0.4;
  bgcolor="white";

  node [fontname="DejaVu Sans", fontsize=13, penwidth=1.6];
  edge [fontname="DejaVu Sans Bold", fontsize=12, penwidth=2.0, arrowsize=1.0];

  // ================= МАГИСТРАЛЬ (цепочка, вес 10 — держит вертикаль) =================
  START [label="СТАРТ\nКакую ОС ставить?", shape=ellipse, style=filled, fillcolor="#1f2937", fontcolor=white, fontsize=14, width=2.4, height=1.1];
  D1 [label="Играешь\nв AAA?", shape=diamond, style=filled, fillcolor="#fef08a", width=2.2, height=1.2];
  D2 [label="ПК слабый?\n≤8 ГБ / 10+ лет", shape=diamond, style=filled, fillcolor="#fef08a", width=2.2, height=1.2];
  D3 [label="Сервер / NAS /\nHomelab?", shape=diamond, style=filled, fillcolor="#fef08a", width=2.2, height=1.2];
  D4 [label="Анонимность /\nпентест?", shape=diamond, style=filled, fillcolor="#fef08a", width=2.2, height=1.2];
  D5 [label="Монтаж / музыка /\nдизайн?", shape=diamond, style=filled, fillcolor="#fef08a", width=2.2, height=1.2];
  D6 [label="Кодишь?", shape=diamond, style=filled, fillcolor="#fef08a", width=2.2, height=1.2];
  D7 [label="Нужны 1С /\nOffice / Photoshop?", shape=diamond, style=filled, fillcolor="#fef08a", width=2.4, height=1.3];
  D8 [label="Apple +\nесть деньги?", shape=diamond, style=filled, fillcolor="#fef08a", width=2.2, height=1.2];
  D9 [label="«Просто работает»?\n(нет = сам настрою)", shape=diamond, style=filled, fillcolor="#fef08a", width=2.6, height=1.4];

  START -> D1 [xlabel="начать", weight=10, color="#1f2937", fontcolor="#1f2937"];
  D1 -> D2 [xlabel="нет", weight=10, color="#1f2937", fontcolor="#1f2937"];
  D2 -> D3 [xlabel="нет", weight=10, color="#1f2937", fontcolor="#1f2937"];
  D3 -> D4 [xlabel="нет", weight=10, color="#1f2937", fontcolor="#1f2937"];
  D4 -> D5 [xlabel="нет", weight=10, color="#1f2937", fontcolor="#1f2937"];
  D5 -> D6 [xlabel="нет", weight=10, color="#1f2937", fontcolor="#1f2937"];
  D6 -> D7 [xlabel="нет", weight=10, color="#1f2937", fontcolor="#1f2937"];
  D7 -> D8 [xlabel="нет", weight=10, color="#1f2937", fontcolor="#1f2937"];
  D8 -> D9 [xlabel="нет", weight=10, color="#1f2937", fontcolor="#1f2937"];

  // ================= ВЕТКА 1: ГЕЙМИНГ =================
  subgraph cluster_gaming {
    label="ВЕТКА: Гейминг";
    style="filled,rounded"; fillcolor="#faf5ff"; color="#c084fc"; fontsize=12;
    D1a [label="Античит?\nValorant / FaceIT", shape=diamond, style=filled, fillcolor="#fdba74", width=2.2, height=1.2];
    D1b [label="Геймпад +\nдиван?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.2, height=1.2];
    D1c [label="Linux,\nно макс. FPS?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.2, height=1.2];
    WIN11 [label="Windows 11\n«все так живут»", shape=box, style="filled,rounded", fillcolor="#bfdbfe"];
    ATLAS [label="AtlasOS\n«выжатая Win для игр»", shape=box, style="filled,rounded", fillcolor="#bfdbfe"];
    BAZZITE [label="Bazzite\n«Deck на максималках»", shape=box, style="filled,rounded", fillcolor="#c4b5fd"];
    CHIMERA [label="ChimeraOS / SteamOS\n«консоль из ПК»", shape=box, style="filled,rounded", fillcolor="#c4b5fd"];
    HOLOISO [label="HoloISO\n«SteamOS на любом ПК»", shape=box, style="filled,rounded", fillcolor="#c4b5fd"];
    NOBARA [label="Nobara\n«Fedora для геймеров»", shape=box, style="filled,rounded", fillcolor="#86efac"];
    CACHY [label="CachyOS\n«Arch на стероидах»", shape=box, style="filled,rounded", fillcolor="#86efac"];
    GARUDA [label="Garuda\n«дракон с RGB»", shape=box, style="filled,rounded", fillcolor="#86efac"];
    POPOS [label="Pop!_OS\n«геймер-инженер»", shape=box, style="filled,rounded", fillcolor="#86efac"];
    PIKAOS [label="PikaOS\n«геймерский Debian»", shape=box, style="filled,rounded", fillcolor="#86efac"];
    SUPERG [label="SuperGamer / Chapeau / Ultimate Edition\n«игры нулевых»", shape=box, style="filled,rounded", fillcolor="#d4d4d8"];
  }
  D1 -> D1a [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  D1a -> WIN11 [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  D1a -> D1b [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  D1b -> BAZZITE [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  D1b -> D1c [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  D1c -> NOBARA [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  D1c -> POPOS [xlabel="нет", weight=1, color="#1f2937", fontcolor="#1f2937"];
  WIN11 -> ATLAS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  BAZZITE -> CHIMERA [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  CHIMERA -> HOLOISO [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  NOBARA -> CACHY [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  CACHY -> GARUDA [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  POPOS -> PIKAOS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  POPOS -> SUPERG [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];

  // ================= ВЕТКА 2: СЛАБЫЙ ПК =================
  subgraph cluster_oldpc {
    label="ВЕТКА: Воскрешение железа";
    style="filled,rounded"; fillcolor="#fefce8"; color="#eab308"; fontsize=12;
    D2a [label="Динозавр?\n1–2 ГБ / 32-бит", shape=diamond, style=filled, fillcolor="#fdba74", width=2.2, height=1.2];
    D2b [label="Красиво\nна 4–8 ГБ?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.2, height=1.2];
    TINYCORE [label="TinyCore / Puppy\n«грузятся из ОЗУ»", shape=box, style="filled,rounded", fillcolor="#fde68a"];
    ANTIX [label="antiX\n«без systemd»", shape=box, style="filled,rounded", fillcolor="#fde68a"];
    ALPINE [label="Alpine\n«5 МБ и ты мужик»", shape=box, style="filled,rounded", fillcolor="#fde68a"];
    CHIMLINUX [label="Chimera Linux\n«musl-десктоп»", shape=box, style="filled,rounded", fillcolor="#fde68a"];
    KOLIBRI [label="KolibriOS\n«1 МБ + GUI!»", shape=box, style="filled,rounded", fillcolor="#fde68a"];
    DSLBOX [label="Damn Small / Feather / MuLinux / Austrumi\n«дистро-диета»", shape=box, style="filled,rounded", fillcolor="#fde68a"];
    SLITAZ [label="SliTaz / 4MLinux / Tiny SliTaz\n«крошки»", shape=box, style="filled,rounded", fillcolor="#fde68a"];
    LINCON [label="LinuxConsole\n«французский live-CD»", shape=box, style="filled,rounded", fillcolor="#fde68a"];
    DELI [label="DeLi / DeLicate / ConnochaetOS\n«ретро-минимализм»", shape=box, style="filled,rounded", fillcolor="#fde68a"];
    TINY2 [label="Monkey / Knopperdisk / DOSLINUX\n«микро-дистро»", shape=box, style="filled,rounded", fillcolor="#fde68a"];
    PUPBOX [label="PuppyRus / Legacy OS / Macpup / Quirky / PUD\n«щенки»", shape=box, style="filled,rounded", fillcolor="#fde68a"];
    RESCUE [label="SystemRescue / grml / Finnix / Knoppix / DRBL / Parted Magic / tomsrtbt / Refracta\n«спасатели»", shape=box, style="filled,rounded", fillcolor="#fde68a"];
    RESCUE2 [label="Rescatux / Super Grub2 Disk / RIP / Stresslinux / PloP / Resulinux\n«чинилки»", shape=box, style="filled,rounded", fillcolor="#fde68a"];
    MORPHIX [label="Morphix / Quantian / DNALinux / ParallelKnoppix / Kaella / Demolinux\n«пионеры live-CD»", shape=box, style="filled,rounded", fillcolor="#fde68a"];
    MINTXFCE [label="Lubuntu / Xubuntu\n«ноут ожил»", shape=box, style="filled,rounded", fillcolor="#86efac"];
    BODHI [label="Bodhi Linux\n«лёгкая и красивая»", shape=box, style="filled,rounded", fillcolor="#86efac"];
    LITELX [label="Linux Lite / LXLE / Peppermint / Fluxbuntu / Greenie / Runtu / TinyMe / U-lite\n«лёгкие Ubuntu»", shape=box, style="filled,rounded", fillcolor="#86efac"];
    SIMPLX [label="Simplicity / Snowlinux / SalineOS / ToriOS\n«лёгкие нулевых»", shape=box, style="filled,rounded", fillcolor="#d4d4d8"];
    EMMAB [label="Emmabuntüs\n«ПК для бедных»", shape=box, style="filled,rounded", fillcolor="#86efac"];
    NETBOOK [label="Eeebuntu / Joli / Jolicloud / gOS / EasyPeasy / Cub / Netbook / Linpus\n«нетбуки»", shape=box, style="filled,rounded", fillcolor="#d4d4d8"];
    MXLINUX [label="MX Linux\n«диванный админ»", shape=box, style="filled,rounded", fillcolor="#86efac"];
    Q4OS [label="Q4OS\n«как XP, но Linux»", shape=box, style="filled,rounded", fillcolor="#86efac"];
    ZORINLITE [label="Zorin Lite\n«для бабушки»", shape=box, style="filled,rounded", fillcolor="#86efac"];
    SPARKY [label="SparkyLinux\n«Debian полегче»", shape=box, style="filled,rounded", fillcolor="#86efac"];
  }
  D2 -> D2a [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  D2a -> TINYCORE [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  D2a -> D2b [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  D2b -> MINTXFCE [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  D2b -> MXLINUX [xlabel="нет", weight=1, color="#1f2937", fontcolor="#1f2937"];
  TINYCORE -> ANTIX [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  TINYCORE -> RESCUE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  RESCUE -> RESCUE2 [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  RESCUE -> MORPHIX [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  ANTIX -> ALPINE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  ANTIX -> DSLBOX [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  DSLBOX -> SLITAZ [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  DSLBOX -> DELI [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  DSLBOX -> TINY2 [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  SLITAZ -> PUPBOX [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  SLITAZ -> LINCON [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  ALPINE -> CHIMLINUX [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  ALPINE -> KOLIBRI [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  MINTXFCE -> BODHI [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  BODHI -> LITELX [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  BODHI -> EMMAB [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  LITELX -> SIMPLX [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  EMMAB -> NETBOOK [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  MXLINUX -> Q4OS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  Q4OS -> ZORINLITE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  ZORINLITE -> SPARKY [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];

  // ================= ВЕТКА 3: СЕРВЕР =================
  subgraph cluster_server {
    label="ВЕТКА: Сервер / NAS / сеть";
    style="filled,rounded"; fillcolor="#fef2f2"; color="#f87171"; fontsize=12;
    D3a [label="Виртуалки?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.2, height=1.2];
    D3b [label="NAS /\nмедиа?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.2, height=1.2];
    D3c [label="Корпоративный\nстандарт?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.2, height=1.2];
    D3d [label="Роутер /\nфайрвол?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.2, height=1.2];
    PROXMOX [label="Proxmox VE\n«домашний дата-центр»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    PELICAN [label="PelicanHPC\n«кластер-флешка»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    RANCHER [label="RancherOS / Container Linux\n«контейнерные»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    TRUENAS [label="TrueNAS SCALE\n«хранитель фильмов»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    OMV [label="OpenMediaVault\n«NAS из старого ПК»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    UNRAID [label="Unraid\n«NAS, но платный»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    CASAOS [label="CasaOS\n«сервер для чайников»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    TURNKEY [label="TurnKey / Univention / Amahi / BlueOnyx / Zentyal\n«сервер в 1 клик»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    SMESRV [label="SME Server / IPCop / Elastix / ClarkConnect / Untangle / Annvix / Nitix / Trustix\n«серверы нулевых»", shape=box, style="filled,rounded", fillcolor="#d4d4d8"];
    RPID [label="Raspberry Pi OS / Raspbian / Twister / DietPi / Arch ARM / Flint OS / OSMC\n«для малинки»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    HTPC [label="LinHES / GeeXboX / LinuxMCE / LibreELEC / MythDora / KnoppMyth\n«медиацентр»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    XIGBOX [label="XigmaNAS / m0n0wall / Openfiler / Rockstor / OviOS\n«олдскул-NAS»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    ROCKY [label="Rocky / Alma / RHEL\n«корпоративный»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    RHELCLONES [label="CentOS / Oracle / Scientific / Rocks / CERN / PUIAS / Springdale / Tao\n«клоны RHEL»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    AMAZON [label="Amazon Linux\n«облако AWS»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    CLOUDLIN [label="CloudLinux\n«хостингам»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    OSCRPM [label="Korora / Kororaa / Yellow Dog / Red Flag / Asianux / Miracle / Fermi / ClearOS\n«покойники RPM»", shape=box, style="filled,rounded", fillcolor="#d4d4d8"];
    SUSELE [label="SUSE / SLES\n«немецкий RHEL»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    DEBIANSRV [label="Debian / Ubuntu Server\n«стоит годами»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    DEVUAN [label="Devuan\n«Debian без systemd»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    OPNSENSE [label="OPNsense\n«роутер-монстр»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    PFSENSE [label="pfSense\n«роутер для офиса»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    OPENWRT [label="OpenWrt\n«прошивка для роутера»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    VYOS [label="VyOS / Vyatta / DD-WRT / IPFire / Endian\n«роутер-гик»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    COYOTE [label="Coyote / FREESCO / BrazilFW\n«роутеры-дискеты»", shape=box, style="filled,rounded", fillcolor="#fca5a5"];
    LEDE [label="LEDE\n«предок OpenWrt»", shape=box, style="filled,rounded", fillcolor="#d4d4d8"];
    FREEBSD [label="FreeBSD\n«ZFS-маньяк»", shape=box, style="filled,rounded", fillcolor="#fecaca"];
    OPENBSD [label="OpenBSD\n«параноик-сервер»", shape=box, style="filled,rounded", fillcolor="#fecaca"];
  }
  D3 -> D3a [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  D3a -> PROXMOX [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  D3a -> D3b [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  D3b -> TRUENAS [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  D3b -> D3c [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  D3c -> ROCKY [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  D3c -> D3d [xlabel="нет", weight=2, color="#1f2937", fontcolor="#1f2937"];
  D3d -> OPNSENSE [xlabel="да", weight=1, color="#1f2937", fontcolor="#1f2937"];
  D3d -> DEBIANSRV [xlabel="нет", weight=1, color="#1f2937", fontcolor="#1f2937"];
  PROXMOX -> PELICAN [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  PROXMOX -> RANCHER [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  TRUENAS -> OMV [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  TRUENAS -> HTPC [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  OMV -> UNRAID [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  OMV -> XIGBOX [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  UNRAID -> CASAOS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  CASAOS -> TURNKEY [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  CASAOS -> RPID [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  TURNKEY -> SMESRV [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  ROCKY -> RHELCLONES [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  ROCKY -> SUSELE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  RHELCLONES -> AMAZON [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  RHELCLONES -> OSCRPM [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  AMAZON -> CLOUDLIN [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  DEBIANSRV -> DEVUAN [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  DEBIANSRV -> FREEBSD [xlabel="или BSD?", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  FREEBSD -> OPENBSD [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  OPNSENSE -> PFSENSE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  PFSENSE -> OPENWRT [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  OPENWRT -> VYOS [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  OPENWRT -> LEDE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];
  VYOS -> COYOTE [xlabel="или", style=dashed, weight=0, color="#0e7490", fontcolor="#0e7490"];

  // ================= ВЕТКА 4: ПРИВАТНОСТЬ / ПЕНТЕСТ =================
  subgraph cluster_privacy {
    label="ВЕТКА: Приватность / пентест";
    style="filled,rounded"; fillcolor="#eef2ff"; color="#818cf8"; fontsize=12;
    D4a [label="Анонимность\nпрямо сейчас?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.2, height=1.2];
    D4b [label="Всё по\nвиртуалкам?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.2, height=1.2];
    D4c [label="Пентест /\nвзлом?", shape=diamond, style=filled, fillcolor="#fdba74", width=2.2, height=1.2];
    TAILS [label="Tails\n«флешка-невидимка»", shape=box, style="filled,rounded", fillcolor="#a5b4fc"];
    LPSBOX [label="LPS / Tinfoil Hat / EnGarde / Devil-Linux / Openwall\n«спецназ»", shape=box, style="filled,rounded", fillcolor="#a5b4fc"];
    LIBERTE [label="Liberté\n«анархия-флешка»", shape=box, style="filled,rounded", fillcolor="#a5b4fc"];
    QUBES [label="Qubes OS\n«всё по виртуалкам»", shape=box, style="filled,rounded", fillcolor="#a5b4fc"];
    HEADS [label="Heads / Septor\n«паранойя в прошивке»", shape=box, style="filled,rounded", fillcolor="#a5b4fc"];
    TORBOX [label="TorBOX\n«Tor-шлюз»", shape=box, style="filled,rounded", fillcolor="#a5b4fc"];
    KALI [label="Kali\n«хакер из кино»", shape=box, style="filled,rounded", fillcolor="#a5b4fc"];
